# Copy this file to .env and fill in your values.

# Your Google Cloud project ID (not the project name)
GCP_PROJECT_ID=your-project-id

# Where BigQuery datasets are created. Keep US unless you have a reason not to.
BQ_LOCATION=US

# Cloud Storage bucket for the raw "data lake" copy.
# Leave empty to skip Cloud Storage and load straight into BigQuery
# (useful on the BigQuery sandbox, which has no billing account).
GCS_BUCKET=

# Dataset names
BQ_RAW_DATASET=taxi_raw
BQ_DATASET=taxi_analytics

# Months of NYC Yellow Taxi data to load (YYYY-MM, comma separated).
# Each month is roughly 3 million rows.
MONTHS=2024-01,2024-02,2024-03

# Safety guardrail: any single query that would scan more than this fails
# instead of running. 20 GB is far more than this project needs.
MAX_BYTES_BILLED=20000000000
